{
    "name": "batch_file_read",
    "description": "批量读取多个文件内容",
    "workflow": {
        "workflow_id": "batch_file_read",
        "description": "搜索文件并批量读取内容",
        "steps": [
            {
                "id": "search",
                "tool": "file_manager_File_search_files",
                "params": {
                    "pattern": "{{pattern}}",
                    "recursive": true,
                    "limit": 10
                }
            },
            {
                "id": "read_files",
                "tool": "file_manager_File_read_file_content",
                "params": {
                    "file_path": "{{item.path}}",
                    "max_size": 5000
                },
                "foreach": "search.files",
                "condition": "{{search.total_found > 0}}",
                "on_error": "continue"
            }
        ],
        "output": {
            "total_files": "{{search.total_found}}",
            "read_results": "{{read_files}}"
        }
    },
    "created_at": "2026-03-13T22:44:00",
    "updated_at": "2026-03-13T22:44:00"
}
