{
    "name": "file_cleanup",
    "description": "搜索并清理指定类型的文件",
    "workflow": {
        "workflow_id": "file_cleanup",
        "description": "搜索指定模式的文件并执行清理操作",
        "steps": [
            {
                "id": "search",
                "tool": "file_manager_File_search_files",
                "params": {
                    "pattern": "{{pattern}}",
                    "recursive": true,
                    "limit": 100
                }
            },
            {
                "id": "report",
                "tool": "txt_handler_TxtToolManager_write_txt",
                "params": {
                    "file_path": "{{output_file}}",
                    "content": "找到 {{search.total_found}} 个文件\n文件列表: {{search.files}}"
                },
                "condition": "{{search.total_found > 0}}"
            }
        ],
        "output": {
            "files_found": "{{search.total_found}}",
            "report_saved": "{{report.success}}"
        }
    },
    "created_at": "2026-03-13T22:44:00",
    "updated_at": "2026-03-13T22:44:00"
}
